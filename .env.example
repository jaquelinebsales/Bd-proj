# Copie este arquivo para .env (na mesma pasta), preencha e SALVE (Ctrl+S). O .env NUNCA vai para o GitHub.
# Depois rode: python scripts/supabase/verificar_env.py
# Ele testa cada chave contra o Supabase sem mostrar nenhum valor e diz o que ainda falta.
# Onde achar cada valor: README.md, seção "Chaves do Supabase".

# ---- Obrigatórias ----
# Project Settings > Data API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings > API Keys (chave publishable: pode ir no app)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Project Settings > API Keys > Secret keys (NUNCA no app)
SUPABASE_SECRET_KEY=sb_secret_...
# A senha que você definiu ao criar o projeto. Se esqueceu: Project Settings > Database > Reset database password
SUPABASE_DB_PASSWORD=
# Token pessoal: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# Uma senha longa que você inventa. Para gerar sozinho: python scripts/supabase/verificar_env.py --gerar-cron-secret
CRON_SECRET=

# ---- Opcionais ----
# DEIXE VAZIA: o script monta a conexão com o banco usando SUPABASE_DB_PASSWORD e SUPABASE_ACCESS_TOKEN.
# Só preencha se quiser usar outra. Copie de Connect > Session pooler. Se a senha tiver @ : / # ? %, não use esta linha.
DATABASE_URL=
# Sai da SUPABASE_URL. Só preencha se o script não conseguir descobrir.
SUPABASE_PROJECT_REF=
# Só se for enviar o código ao GitHub por aqui: token fino do repositório, com permissão de escrita em Contents
GITHUB_TOKEN=
