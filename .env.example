# Copie este arquivo para .env (na mesma pasta) e preencha. O .env NUNCA vai para o GitHub.
# Onde achar cada valor: README.md, seção "Chaves do Supabase".

# ---- Públicas: podem ir no app (protegidas pelas regras de acesso do banco) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
GOOGLE_MAPS_API_KEY=

# ---- Secretas: só neste computador e nos segredos do GitHub. Nunca no app. ----
# Chave secreta nova (sb_secret_...) ou, em projetos antigos, a service_role.
SUPABASE_SECRET_KEY=sb_secret_...
# Conexão com o banco (Session pooler), usada pelo script de importação da ANP
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-1-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Token pessoal da sua conta Supabase, usado pelo GitHub Actions para publicar
SUPABASE_ACCESS_TOKEN=sbp_...
# Senha que você inventa: protege a sincronização automática com a ANP
CRON_SECRET=
